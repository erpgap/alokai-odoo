    <field name="uom_po_id" ref="uom.product_uom_unit"/>
    <field name="invoice_policy">delivery</field>
    <field name="default_code">TBL-ELM-003</field>
    <field name="public_categ_ids" eval="[(6, 0, [ref('ppc_tables'), ref('ppc_tbl_coffee')])]"/>
    <field name="description_sale">Rectangular minimalist coffee table in smooth light grey concrete.</field>
    <field name="image_1920" type="base64" file="graphql_alokai/static/tables/coffee/img1.webp"/>
  </record>


