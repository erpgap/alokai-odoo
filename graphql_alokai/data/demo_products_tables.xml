<record id="tbl_terra_travertine_dining_attr_color" model="product.template.attribute.line">
    <field name="product_tmpl_id" ref="tbl_terra_travertine_dining"/>
    <field name="attribute_id" ref="attr_color"/>
    <field name="value_ids" eval="[(6, 0, [
        ref('attr_color_beige'),
        ref('attr_color_black')
    ])]"/>
</record>

<function model="ir.model.data" name="_update_xmlids">
    <value model="base" eval="[{
        'xml_id': 'graphql_alokai.tbl_terra_travertine_dining_attr_color_value_1',
        'record': obj().env.ref('graphql_alokai.tbl_terra_travertine_dining_attr_color').product_template_value_ids[0],
        'noupdate': True,
    }, {
        'xml_id': 'graphql_alokai.tbl_terra_travertine_dining_attr_color_value_2',
        'record': obj().env.ref('graphql_alokai.tbl_terra_travertine_dining_attr_color').product_template_value_ids[1],
        'noupdate': True,
    }]"/>
</function>

<function model="ir.model.data" name="_update_xmlids">
    <value model="base" eval="[{
        'xml_id': 'graphql_alokai.tbl_terra_travertine_dining_black',
        'record': obj().env.ref('graphql_alokai.tbl_terra_travertine_dining')._get_variant_for_combination(
            obj().env.ref('graphql_alokai.tbl_terra_travertine_dining_attr_color_value_1')
        ),
        'noupdate': True,
    }, {
        'xml_id': 'graphql_alokai.tbl_terra_travertine_dining_beige',
        'record': obj().env.ref('graphql_alokai.tbl_terra_travertine_dining')._get_variant_for_combination(
            obj().env.ref('graphql_alokai.tbl_terra_travertine_dining_attr_color_value_2')
        ),
        'noupdate': True,
    }]"/>
</function>

