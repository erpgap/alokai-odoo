<!-- The "Element" Concrete Coffee Table -->
  <record id="tbl_element_coffee" model="product.template">
    <field name="name">The Element Concrete Coffee Table</field>
    <field name="categ_id" ref="product.product_category_all"/>
    <field name="list_price">399.00</field>
    <field name="standard_price">239.40</field>
    <field name="type">consu</field>
    <field name="is_storable" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="taxes_id" eval="False"/>
