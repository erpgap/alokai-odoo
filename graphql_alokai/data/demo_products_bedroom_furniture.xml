<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- 1) The "Zen" Platform Bed -->
  <record id="bed_zen_platform" model="product.template">
    <field name="name">The "Zen" Platform Bed</field>
    <field name="categ_id" ref="product.product_category_all"/>
    <field name="list_price">899.00</field>
    <field name="standard_price">539.40</field>
    <field name="type">consu</field>
    <field name="is_storable" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="taxes_id" eval="False"/>
    <field name="uom_id" ref="uom.product_uom_unit"/>
    <field name="uom_po_id" ref="uom.product_uom_unit"/>
    <field name="invoice_policy">delivery</field>
    <field name="default_code">BED-ZEN-001</field>
    <field name="public_categ_ids"
           eval="[(6, 0, [ref('ppc_bedroom_furniture'),
                          ref('ppc_bed_beds')])]"/>
    <field name="description_sale">
      Low-profile queen-size platform bed frame in Japanese ash wood; minimalist, clean lines.
    </field>
    <field name="image_1920" type="base64"
           file="graphql_alokai/static/bedroom_furniture/beds/img1.webp"/>
  </record>

  <record id="img_bed_zen_platform_1" model="product.image">
    <field name="product_tmpl_id" ref="bed_zen_platform"/>
    <field name="name">Angle View</field>
    <field name="sequence">1</field>
    <field name="image_1920" type="base64"
           file="graphql_alokai/static/bedroom_furniture/beds/img2.webp"/>
  </record>

