<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- =========================
       ATTRIBUTE: Color
       (uses the “color” display type to show a color chip)
       ========================= -->
  <record id="attr_color" model="product.attribute">
    <field name="name">Color</field>
    <field name="display_type">color</field>
    <field name="sequence">10</field>
  </record>

  <!-- === Color values === -->
  <record id="attr_color_black" model="product.attribute.value">
    <field name="name">Black</field>
    <field name="attribute_id" ref="attr_color"/>
    <field name="html_color">#000000</field>
    <field name="sequence">1</field>
  </record>

  <record id="attr_color_white" model="product.attribute.value">
    <field name="name">White</field>
    <field name="attribute_id" ref="attr_color"/>
    <field name="html_color">#FFFFFF</field>
    <field name="sequence">2</field>
  </record>

  <record id="attr_color_grey" model="product.attribute.value">
    <field name="name">Grey</field>
    <field name="attribute_id" ref="attr_color"/>
    <field name="html_color">#BFBFBF</field>
    <field name="sequence">3</field>
  </record>

  <record id="attr_color_yellow" model="product.attribute.value">
    <field name="name">Yellow</field>
    <field name="attribute_id" ref="attr_color"/>
    <field name="html_color">#FFD700</field>
    <field name="sequence">4</field>
  </record>

  <record id="attr_color_dark_blue" model="product.attribute.value">
    <field name="name">Dark Blue</field>
    <field name="attribute_id" ref="attr_color"/>
    <field name="html_color">#0B2C5F</field>
    <field name="sequence">5</field>
  </record>

  <record id="attr_color_dark_green" model="product.attribute.value">
    <field name="name">Dark Green</field>
    <field name="attribute_id" ref="attr_color"/>
    <field name="html_color">#0F7B5F</field>
    <field name="sequence">6</field>
  </record>

  <record id="attr_color_pattern" model="product.attribute.value">
    <field name="name">Pattern</field>
    <field name="attribute_id" ref="attr_color"/>
    <field name="html_color">#CCCCCC</field>
    <field name="sequence">7</field>
  </record>

</odoo>
