    <field name="description_sale">5-tier leaning ladder bookshelf with black metal frame.</field>
    <field name="image_1920" type="base64" file="graphql_alokai/static/storage_shelving/bookshelves/img1.webp"/>
  </record>
  <record id="img_stg_ladder_bookshelf_1" model="product.image">
    <field name="product_tmpl_id" ref="stg_ladder_bookshelf"/>
