  <!-- 1) Ladder Bookshelf — Bookshelves -->
  <record id="stg_ladder_bookshelf" model="product.template">
    <field name="name">The Ladder Bookshelf</field>
    <field name="categ_id" ref="product.product_category_all"/>
    <field name="list_price">219.00</field>
    <field name="standard_price">131.40</field>
    <field name="type">consu</field>
    <field name="is_storable" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="taxes_id" eval="False"/>
    <field name="uom_id" ref="uom.product_uom_unit"/>
    <field name="uom_po_id" ref="uom.product_uom_unit"/>
    <field name="invoice_policy">delivery</field>
    <field name="default_code">STG-LADD-007</field>
