    Images for the demo content pages, in the CMS media library. Filed the way
    an editor upload is (public, res_model alokai.website.page), so they show
    in the library and are served by /web/image like any other upload. The
    pages refer to them through their XML ids; see _seed_cms_demo_pages.
-->
<odoo noupdate="1">

    <record id="cms_demo_image_about_banner" model="ir.attachment">
        <field name="name">about-banner.webp</field>
        <field name="datas" type="base64" file="graphql_alokai/data/cms_demo_images/about-banner.webp"/>
        <field name="mimetype">image/webp</field>
        <field name="res_model">alokai.website.page</field>
