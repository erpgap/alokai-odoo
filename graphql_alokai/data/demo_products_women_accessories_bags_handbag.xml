    <record id="women_accessories_bags_handbag_template_1" model="product.template">
        <field name="name">Top Handle Bag</field>
        <field name="categ_id" ref="graphql_alokai.product_category_pants" />
        <field name="list_price">150.0</field>
        <field name="standard_price">75.0</field>
        <field name="is_published" eval="True" />
        <field name="type">consu</field>
        <field name="is_storable" eval="True" />
        <field name="taxes_id" eval="False" />
        <field name="uom_id" ref="uom.product_uom_unit" />
        <field name="invoice_policy">delivery</field>
        <field name="default_code">WHBG0001</field>
        <field name="description_sale">Discover the Top Handle Bag, designed for those who appreciate quality and style. Crafted from premium materials, this top handle bag offers a perfect balance of comfort and elegance. The thoughtful design ensures a flattering silhouette that complements any look. Versatile enough for both day and evening wear, it pairs effortlessly with your existing wardrobe. Built to last with attention to every detail, this is a timeless addition to your collection.</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('graphql_alokai.public_category_women_accessories_handbags')])]" />
    </record>
    <record id="women_accessories_bags_handbag_template_1_attr_color" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="women_accessories_bags_handbag_template_1" />
        <field name="attribute_id" ref="product_attribute_color" />
        <field name="value_ids" eval="[(6, 0, [ref('product_attribute_color_black'), ref('product_attribute_color_cognac')])]" />
    </record>
