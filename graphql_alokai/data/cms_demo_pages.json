          "eyebrow": {
            "en_US": "About"
          },
          "title": {
            "en_US": "Built by ERPGAP"
          },
          "subtitle": {
            "en_US": "Alokai is a showcase storefront connecting Odoo to a modern, headless shopping experience."
          },
          "image": {
            "en_US": "{image:graphql_alokai.cms_demo_image_about_banner}"
          }
        }
      },
      {
        "id": "about_2",
        "blockType": "richText",
        "schemaVersion": 1,
        "data": {
          "variant": "text",
          "eyebrow": {
            "en_US": "Our story"
          },
          "title": {
            "en_US": ""
          },
          "body": {
            "en_US": "ERPGAP helps businesses run on Odoo — and sell beautifully on top of it. Alokai is our open storefront that proves how good headless commerce on Odoo can look and feel."
          },
          "align": "left",
          "width": "column",
          "size": "lead",
          "spacing": "normal",
          "divider": false,
          "ctaLabel": {
            "en_US": ""
          },
          "ctaUrl": {
            "en_US": ""
          },
          "ctaPosition": "below"
        }
      },
      {
        "id": "about_3",
        "blockType": "featureList",
        "schemaVersion": 1,
        "data": {
          "title": {
            "en_US": ""
          },
          "layout": "band",
          "numberPosition": "above",
          "columns": "3",
          "numbered": true,
          "items": [
            {
              "title": {
                "en_US": "Odoo at the core"
              },
              "text": {
                "en_US": "ERPGAP are Odoo specialists. Alokai plugs a modern storefront straight into Odoo for catalog, pricing, inventory and orders — one source of truth."
              }
            },
            {
              "title": {
                "en_US": "Headless & fast"
              },
              "text": {
                "en_US": "Built on Nuxt and the Alokai (Vue Storefront) framework for a fast, SEO-friendly, fully customisable shopping experience."
              }
            },
            {
              "title": {
                "en_US": "Open & extensible"
              },
              "text": {
                "en_US": "A composable architecture you own end to end — themeable, API-first, and ready to grow with your business."
              }
            }
          ]
        }
      },
      {
        "id": "about_4",
        "blockType": "editorial",
        "schemaVersion": 1,
        "data": {
          "eyebrow": {
            "en_US": "The showcase"
          },
          "title": {
            "en_US": "Commerce, the composable way"
          },
          "body": {
            "en_US": "Everything you see here — the catalog, cart, search and checkout — is powered by Odoo through the Alokai framework. It's a template you can make entirely your own."
          },
          "image": {
            "en_US": "{image:graphql_alokai.cms_demo_image_about_editorial}"
          },
