        "blockType": "faq",
        "schemaVersion": 1,
        "data": {
          "title": {
            "en_US": ""
          },
          "spacing": "compact",
          "items": [
            {
              "group": {
                "en_US": "Orders"
              },
              "question": {
                "en_US": "Can I change or cancel my order?"
              },
              "answer": {
                "en_US": "Orders can be changed or cancelled within one hour of placing them, before they enter our dispatch queue. Contact us as soon as possible and we'll do our best to help."
              }
            },
            {
              "group": {
                "en_US": "Orders"
              },
              "question": {
                "en_US": "How do I track my order?"
              },
              "answer": {
                "en_US": "Every dispatch email includes a live tracking link — no account required. You can follow your parcel from our warehouse to your door."
              }
            },
            {
              "group": {
                "en_US": "Shipping"
              },
              "question": {
                "en_US": "Do you ship internationally?"
              },
              "answer": {
                "en_US": "Yes, we ship worldwide. Duties and taxes, where applicable, are calculated transparently at checkout. See our Shipping page for delivery estimates."
              }
            },
            {
              "group": {
                "en_US": "Shipping"
              },
              "question": {
                "en_US": "How much is shipping?"
              },
              "answer": {
                "en_US": "Standard shipping is complimentary on orders over $150, and a flat $8 below that. Express and international rates are shown at checkout."
              }
            },
            {
              "group": {
                "en_US": "Returns"
              },
              "question": {
                "en_US": "What is your return policy?"
              },
              "answer": {
                "en_US": "Return any unworn item with its original tags within 30 days for a full refund or exchange. Final-sale items and gift cards are excluded."
              }
            },
            {
              "group": {
                "en_US": "Returns"
              },
              "question": {
                "en_US": "When will I be refunded?"
              },
              "answer": {
                "en_US": "Refunds are issued to your original payment method within 5 business days of your return arriving back with us."
              }
            },
            {
              "group": {
                "en_US": "Products & care"
              },
              "question": {
                "en_US": "What materials do you use?"
              },
              "answer": {
                "en_US": "Our pieces are cut from natural fabrics — organic cotton, pure linen and full-grain leather — chosen to wear in beautifully over time."
              }
            },
            {
              "group": {
                "en_US": "Products & care"
              },
              "question": {
                "en_US": "How should I care for my pieces?"
              },
              "answer": {
                "en_US": "Care instructions are printed on each garment's label. As a rule, cooler washes and air-drying keep natural fibres looking their best for longer."
              }
            }
          ]
        }
      },
