            "en_US": ""
          },
          "title": {
            "en_US": ""
          },
          "body": {
            "en_US": "We believe the most responsible product is one you keep for years. That principle shapes the materials we choose, the way we make, and how we get it to you."
          },
          "align": "left",
          "width": "column",
          "size": "lead",
          "spacing": "compact",
          "divider": false,
          "ctaLabel": {
            "en_US": ""
          },
          "ctaUrl": {
            "en_US": ""
          },
          "ctaPosition": "below"
        }
      },
      {
        "id": "sustainability_4",
        "blockType": "featureList",
        "schemaVersion": 1,
        "data": {
          "title": {
            "en_US": ""
          },
          "layout": "band",
          "numberPosition": "beside",
          "columns": "2",
          "numbered": true,
          "items": [
            {
              "title": {
                "en_US": "Natural materials"
              },
              "text": {
                "en_US": "Organic cotton, pure linen and responsibly sourced leather — fibres chosen to last and to age well."
              }
            },
            {
              "title": {
                "en_US": "Made to last"
              },
              "text": {
                "en_US": "We design against the trend cycle. Fewer, better pieces mean less waste over a garment's life."
              }
            },
            {
              "title": {
                "en_US": "Lower-impact shipping"
              },
              "text": {
                "en_US": "Recyclable, plastic-free packaging and carbon-aware carriers on every order."
              }
            },
            {
              "title": {
                "en_US": "Transparent sourcing"
              },
              "text": {
                "en_US": "We work with partners who share our standards on materials, labour and traceability."
              }
            }
          ]
        }
      },
      {
        "id": "sustainability_5",
        "blockType": "editorial",
        "schemaVersion": 1,
        "data": {
          "eyebrow": {
            "en_US": "A work in progress"
          },
          "title": {
            "en_US": "Honest about the journey"
          },
          "body": {
            "en_US": "We don't claim to be perfect. Sustainability is a direction, not a badge — and we'd rather share real progress than greenwash. This is a demo showcase, but the principles reflect how we'd build a responsible brand."
          },
          "image": {
