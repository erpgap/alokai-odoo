<odoo>

  <!-- 1) Arc Floor Lamp -->
  <record id="lgt_arc_floor_lamp" model="product.template">
    <field name="name">The Arc Floor Lamp</field>
    <field name="categ_id" ref="product.product_category_all"/>
    <field name="list_price">179.00</field>
    <field name="standard_price">107.40</field>
    <field name="type">consu</field>
    <field name="is_storable" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="taxes_id" eval="False"/>
    <field name="uom_id" ref="uom.product_uom_unit"/>
    <field name="uom_po_id" ref="uom.product_uom_unit"/>
    <field name="invoice_policy">delivery</field>
    <field name="default_code">LGT-ARC-009</field>
    <field name="public_categ_ids" eval="[(6, 0, [ref('ppc_lighting'), ref('ppc_lgt_floor_lamps')])]"/>
    <field name="description_sale">Arc floor lamp with black shade and white marble base.</field>
    <field name="image_1920" type="base64" file="graphql_alokai/static/lighting/desk_table_lamps/img1.png"/>
  </record>
  <record id="img_lgt_arc_floor_lamp_1" model="product.image">
